<Window x:Class="Puissance4.Interface.FenetreJeu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Puissance4.Interface"
        mc:Ignorable="d"
        Background="#FF0A111F"
        FontFamily="{StaticResource PlaypenSans}"
        Foreground="White"
        Title="Puissance 4" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="BorderScore" Grid.Column="0" Margin="10,20,0,0" Height="120" VerticalAlignment="Top" 
                BorderBrush="#cbc7b7" BorderThickness="4" CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtBlockJoueur1" Grid.Row="0" Grid.Column="1" Text="[Joueur 1]"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#cafc00"/>
                <TextBlock x:Name="TxtBlockJoueur2" Grid.Row="0" Grid.Column="2" Text="[Joueur 2]"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#bd0000"/>

                <TextBlock Text="Score" Grid.Row="1" Grid.Column="0"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtBlockScoreJoueur1" Grid.Row="1" Grid.Column="1" Text="0"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtBlockScoreJoueur2" Grid.Row="1" Grid.Column="2" Text="0"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
            <Button x:Name="BtnFinirChallenge" Content="Finir le Challenge" Height="40" Width="160" Background="#cbc7b7"
                    FontSize="16" Foreground="#0a111f" Visibility="Hidden"
                    HorizontalAlignment="Left" Margin="10" Click="BtnFinirChallenge_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnRelancerPartie" Content="Relancer une partie" Height="40" Width="160" Background="#cbc7b7"
                    FontSize="16" Foreground="#0a111f" Visibility="Hidden"
                    HorizontalAlignment="Left" Margin="10" Click="BtnRelancerPartie_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <StackPanel x:Name="StackCentre" Grid.Column="1">
            <TextBlock x:Name="TxtTitre" Text="Puissance 4 !" FontSize="24" HorizontalAlignment="Center" Margin="5"/>
            <TextBlock x:Name="TxtBlockAuTour" FontSize="24" HorizontalAlignment="Center" Margin="5">
                <Run Text="C'est au tour de "/>
                <Run x:Name="RunTxtBlockAuTourDe" Text="Joueur 1" Foreground="#cafc00"/>
            </TextBlock>

            <Grid x:Name="GridTableJeu">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition x:Name="Column8" Width="0*"/>
                    <ColumnDefinition x:Name="Column9" Width="0*"/>
                    <ColumnDefinition x:Name="Column10" Width="0*"/>
                    <ColumnDefinition x:Name="Column11" Width="0*"/>
                    <ColumnDefinition x:Name="Column12" Width="0*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition x:Name="Row8" Height="0*"/>
                    <RowDefinition x:Name="Row9" Height="0*"/>
                    <RowDefinition x:Name="Row10" Height="0*"/>
                    <RowDefinition x:Name="Row11" Height="0*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="A" FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Z" FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="E" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="R" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="T" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="Y" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="U" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="7" Text="I" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="8" Text="O" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="9" Text="P" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="10" Text="Q" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="11" Text="S" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                
                <!-- Grille de jeu réalisée par le C# -->
            </Grid>
            <TextBlock x:Name="TxtBlockTempsRestant" Text="Temps restant : 0s" FontSize="18" HorizontalAlignment="Center" 
                       Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <ListBox x:Name="ListBoxHistorique" 
         Grid.Column="2" 
         Margin="0,20,10,0" 
         BorderBrush="#FFCBC7B7" 
         Background="{x:Null}" 
         BorderThickness="4" 
         Height="220" 
         VerticalAlignment="Top"
         FontSize="16">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="20">
                        <ScrollViewer>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ListBox.Template>
        </ListBox>
        <Button x:Name="BtnQuitter" Grid.Column="2" Content="Quitter" Height="44" Width="140" Background="#cbc7b7"
                FontSize="16" Foreground="#0a111f"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Click="BtnQuitter_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="10" 
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
