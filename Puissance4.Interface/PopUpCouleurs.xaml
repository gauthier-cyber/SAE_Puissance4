<Window x:Class="Puissance4.Interface.PopUpCouleurs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Puissance4.Interface"
        mc:Ignorable="d"
        Title="Puissance 4" Height="320" Width="650"
        Background="#FF0A111F"
        FontFamily="{StaticResource PlaypenSans}"
        Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="15">
            <TextBlock Text="Couleurs" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                <Border x:Name="BorderCouleur1" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderCouleurs_MouseLeftButtonDown" Tag="#bd0000,#cafc00">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="30" Height="30" Fill="#bd0000" Margin="4"/>
                        <Ellipse Width="30" Height="30" Fill="#cafc00" Margin="4"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BorderCouleur2" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderCouleurs_MouseLeftButtonDown" Tag="#ffffff,#000000">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="30" Height="30" Fill="#ffffff" Margin="4"/>
                        <Ellipse Width="30" Height="30" Fill="#000000" Margin="4"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                <Border x:Name="BorderCouleur3" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderCouleurs_MouseLeftButtonDown" Tag="#737373,#44433c">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="30" Height="30" Fill="#737373" Margin="4"/>
                        <Ellipse Width="30" Height="30" Fill="#44433c" Margin="4"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BorderCouleur4" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderCouleurs_MouseLeftButtonDown" Tag="#0025cc,#401268">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="30" Height="30" Fill="#0025cc" Margin="4"/>
                        <Ellipse Width="30" Height="30" Fill="#401268" Margin="4"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                <Border x:Name="BorderCouleur5" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderCouleurs_MouseLeftButtonDown" Tag="#457a00,#3d3100">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="30" Height="30" Fill="#457a00" Margin="4"/>
                        <Ellipse Width="30" Height="30" Fill="#3d3100" Margin="4"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BorderCouleur6" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderCouleurs_MouseLeftButtonDown" Tag="#fc9700,#8caa13">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="30" Height="30" Fill="#fc9700" Margin="4"/>
                        <Ellipse Width="30" Height="30" Fill="#8caa13" Margin="4"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Column="1" Width="2" Fill="Black" VerticalAlignment="Stretch" Margin="0,10"/>

        <StackPanel Grid.Column="2" Margin="15">
            <TextBlock Text="Formes" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                <Border x:Name="BorderForme1" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderFormes_MouseLeftButtonDown" Tag="Rond">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="30" Height="30" Fill="#bd0000" Margin="4"/>
                        <Ellipse Width="30" Height="30" Fill="#cafc00" Margin="4"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BorderForme2" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderFormes_MouseLeftButtonDown" Tag="Triangle">
                    <StackPanel Orientation="Horizontal">
                        <Polygon Points="15,0 30,30 0,30" Fill="#bd0000" Margin="4"/>
                        <Polygon Points="15,0 30,30 0,30" Fill="#cafc00" Margin="4"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                <Border x:Name="BorderForme3" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderFormes_MouseLeftButtonDown" Tag="Croix">
                    <StackPanel Orientation="Horizontal">
                        <Polygon Points="15,0 20,10 30,15 20,20 15,30 10,20 0,15 10,10"
                                 Fill="#bd0000" Margin="4"/>
                        <Polygon Points="15,0 20,10 30,15 20,20 15,30 10,20 0,15 10,10"
                                 Fill="#cafc00" Margin="4"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BorderForme4" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderFormes_MouseLeftButtonDown" Tag="Etoile">
                    <StackPanel Orientation="Horizontal">
                        <Polygon Points="15,0 19,11 30,11 21,19 25,30 15,23 5,30 9,19 0,11 11,11"
                                 Fill="#bd0000" Margin="4"/>
                        <Polygon Points="15,0 19,11 30,11 21,19 25,30 15,23 5,30 9,19 0,11 11,11"
                                 Fill="#cafc00" Margin="4"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                <Border x:Name="BorderForme5" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderFormes_MouseLeftButtonDown" Tag="Carre">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="30" Height="30" Fill="#bd0000" RadiusX="7.5" RadiusY="7.5" Margin="4"/>
                        <Rectangle Width="30" Height="30" Fill="#cafc00" RadiusX="7.5" RadiusY="7.5" Margin="4"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BorderForme6" Background="#cbc7b7" CornerRadius="20" Padding="8" Margin="4" 
                        BorderBrush="Transparent" BorderThickness="4"
                        MouseLeftButtonDown="BorderFormes_MouseLeftButtonDown" Tag="Losange">
                    <StackPanel Orientation="Horizontal">
                        <Polygon Points="15,0 30,15 15,30 0,15" Fill="#bd0000" Margin="4"/>
                        <Polygon Points="15,0 30,15 15,30 0,15" Fill="#cafc00" Margin="4"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>