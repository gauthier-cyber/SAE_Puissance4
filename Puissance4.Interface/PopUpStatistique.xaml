<Window x:Class="Puissance4.Interface.PopUpStatistique"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Puissance4.Interface"
        mc:Ignorable="d"
        Title="Puissance 4" Height="390" Width="400">
    <StackPanel Background="#FF0A111F">
        <TextBlock Text="Statistique de la partie" FontFamily="{StaticResource PlaypenSans}" Foreground="White" FontSize="24"
                   HorizontalAlignment="Center" Margin="10"/>
        <Border Width="300" Height="240" BorderThickness="4" BorderBrush="White" CornerRadius="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Gagnant :" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>
                <TextBlock Text="Premier coup :" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>
                <TextBlock Text="Coup décisif :" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>
                <TextBlock Text="Durée :" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>
                <TextBlock Text="Coups :" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>

                <TextBlock x:Name="TxtGagnant" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>
                <TextBlock x:Name="TxtPremierCoup" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>
                <TextBlock x:Name="TxtCoupDecisif" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>
                <TextBlock x:Name="TxtDuree" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>
                <TextBlock x:Name="TxtCoups" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"/>

                <TextBlock x:Name="TxtBlockLibelleScore" Text="Score (challenge) :" Grid.Row="5" Grid.Column="0"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="TxtScore" Grid.Row="5" Grid.Column="1"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"
                           FontFamily="{StaticResource PlaypenSans}" FontSize="18" Foreground="White"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>